# Rolecall Cloud API configuration. Copy to .env (never commit real secrets).
NODE_ENV=development
HOST=0.0.0.0
PORT=8787
LOG_LEVEL=info

# pglite://memory (default, data lost on exit) | pglite://./.data/pglite (persisted) | postgres://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=pglite://memory
# Run migrations at boot for Postgres (PGlite always migrates). Set false and run `node dist/db/migrate.js` as a deploy task when scaling out.
MIGRATE_ON_BOOT=true

# Base URL of the dashboard: used for run links and Stripe redirect URLs.
PUBLIC_URL=http://localhost:8787
# Comma-separated browser origins allowed by CORS (empty = CORS disabled).
CORS_ORIGINS=http://localhost:5173
# true only behind a proxy/load balancer that sets X-Forwarded-For.
TRUST_PROXY=false

# Rate limits
RATE_LIMIT_MAX=600
SIGNUP_RATE_LIMIT_MAX=10

# Stripe (optional). Without STRIPE_SECRET_KEY, POST /v1/billing/checkout returns 501 billing_disabled.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_TEAM=
STRIPE_PRICE_ASSURANCE=
