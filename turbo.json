{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "rolecall#build": {
      "dependsOn": [
        "^build",
        "@rolecall/ui#build"
      ],
      "outputs": [
        "dist/**"
      ]
    }
  }
}
