# Copy to .env (never commit it). Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Model that writes attacks for `rolecall attacks` (any OpenRouter model id).
ROLECALL_ATTACK_MODEL=deepseek/deepseek-v4.1-flash

# Optional: run the demo agent on a real LLM instead of the offline rule-based stand-in.
# Then: rolecall run --mode record  (once), and rolecall run  (replays offline).
ROLECALL_DEMO_MODEL=google/gemini-2.5-flash-lite
