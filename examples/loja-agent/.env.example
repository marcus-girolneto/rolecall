# Copie para .env (nunca faça commit). Chave em https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Modelo do chatbot da loja (qualquer modelo do OpenRouter com suporte a ferramentas).
LOJA_MODELO=google/gemini-2.5-flash-lite

# Modelo que escreve os ataques no `rolecall attacks`.
ROLECALL_ATTACK_MODEL=deepseek/deepseek-v4.1-flash
