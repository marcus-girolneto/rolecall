# Copie para .env (nunca faça commit). Chave em https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Modelo do chatbot da loja. Vários, separados por vírgula: se o primeiro estiver congestionado, usa o próximo.
LOJA_MODELO=google/gemini-2.5-flash-lite,deepseek/deepseek-v4.1-flash,openai/gpt-oss-120b

# Modelo que escreve os ataques no `rolecall attacks`.
ROLECALL_ATTACK_MODEL=deepseek/deepseek-v4.1-flash
