# Copy to .env (never commit it). Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# The store chatbot's model. Several ids separated by commas: if the first is busy, the next one is used.
STORE_MODEL=google/gemini-2.5-flash-lite,deepseek/deepseek-v4.1-flash,openai/gpt-oss-120b

# The model that writes attacks for `rolecall attacks`.
ROLECALL_ATTACK_MODEL=deepseek/deepseek-v4.1-flash
